# Copie este ficheiro para ".env" e ajuste os valores.

# Porta onde o servidor local vai correr
PORT=3000

# Número de WhatsApp do RESOLVE.AO, no formato aceite pelo wa.me (só dígitos, com código do país, sem "+")
BUSINESS_PHONE=244931719199

# Diretório de dados persistentes. Localmente, pode ficar vazio para usar ./data.
# No Railway, RAILWAY_VOLUME_MOUNT_PATH é definido automaticamente quando existe um Volume.
DATA_DIR=
